        }
      }
    },
    "Your habits will be replaced by a demo dataset while dev mode is on. Your real habits are safe and will return as soon as you turn it off." : {
      "comment" : "A message displayed in a confirmation alert.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
