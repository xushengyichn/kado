        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "习惯记录已安全保存在本机，但最近的修改尚未同步到 iCloud。"
          }
        }
      }
    },
    "Your habits are saved locally. No account or payment is needed. Export a backup to keep a copy." : {
      "comment" : "Explain local storage in the Settings screen.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes habitudes sont enregistrées sur cet appareil, sans compte ni paiement. Exporte une sauvegarde pour en garder une copie."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "习惯记录保存在本机，无需账户或付费。可导出备份保留副本。"
          }
        }
      }
    },
    "Your habits stay in sync across every device signed into the same Apple ID." : {
      "comment" : "A description of how the app synchronizes data with iCloud.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "fr" : {
